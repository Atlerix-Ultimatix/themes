  "css": "/* The astromech in a grey studio: white panels, blue trims, a red sensor light. */\n\n.min-h-screen.surface-fond {\n  background-image: linear-gradient(90deg, color-mix(in srgb, var(--surface-fond) 94%, transparent) 0%, color-mix(in srgb, var(--surface-fond) 80%, transparent) 45%, color-mix(in srgb, var(--surface-fond) 25%, transparent) 100%), var(--image-r2);\n  background-size: cover, auto 100vh;\n  background-position: center, right center;\n  background-repeat: no-repeat;\n  background-attachment: fixed;\n}\n.surface-carte { background-color: color-mix(in srgb, var(--surface-carte) 90%, transparent); }\n/* Cards as glossy white plastic: a lit top edge, a soft shadow. */\n.surface-carte.border, .rounded-2xl.border {\n  border: 1px solid rgba(20, 36, 94, 0.08);\n  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 38%);\n  box-shadow: 0 14px 30px rgba(20, 36, 94, 0.14), 0 2px 4px rgba(20, 36, 94, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.9);\n}\n[data-app-menubar] { background-color: var(--surface-carte); box-shadow: 0 6px 18px rgba(20, 36, 94, 0.08); }\n.surface-menu { background-image: linear-gradient(180deg, color-mix(in srgb, var(--surface-menu) 88%, #ffffff), var(--surface-menu)); border-right: 1px solid rgba(255, 255, 255, 0.5); }\n[data-nav-title] { color: #aac0ff; text-transform: uppercase; letter-spacing: 0.2em; font-size: 10px; font-weight: 800; }\n/* The open page: the red sensor light, pulsing. */\n[aria-current=\"page\"] { animation: sw-r2-sensor 2.4s ease-in-out infinite; }\n@keyframes sw-r2-sensor {\n  0%, 100% { box-shadow: inset 4px 0 0 #ff3b3b, inset 24px 0 24px -12px rgba(255, 59, 59, 0.20); }\n  50% { box-shadow: inset 4px 0 0 #ff6b6b, inset 24px 0 24px -12px rgba(255, 59, 59, 0.45), 0 0 12px rgba(255, 59, 59, 0.25); }\n}\n/* Titles: dark blue, underlined by plates. */\nh1 { font-weight: 800; letter-spacing: -0.01em; color: var(--color-primary-700); }\n@media (prefers-reduced-motion: reduce) { [aria-current=\"page\"] { animation: none; box-shadow: inset 4px 0 0 #ff3b3b; } }\n[role=\"dialog\"] { box-shadow: 0 0 0 1px rgba(35, 71, 196, 0.35), 0 24px 32px rgba(20, 36, 94, 0.25); }\n",
